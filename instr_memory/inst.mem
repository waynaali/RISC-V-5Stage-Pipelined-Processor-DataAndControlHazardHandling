// RV32I Cache + AXI Verification Program
// Data base = 0x100

//main:
//    addi x10, x0, 256      # x10 = 0x100 data base
//    addi x1,  x0, 100      # x1 = 100
//    addi x2,  x0, 5        # x2 = 5
//    addi x3,  x0, 12       # x3 = 12
//    add  x4,  x2, x3       # x4 = 17
//    sub  x5,  x4, x2       # x5 = 12
//    and  x6,  x5, x3       # x6 = 12
//    or   x7,  x2, x3       # x7 = 13
//    slt  x8,  x2, x3       # x8 = 1

//    sw   x1,  0(x10)       # [0x100] = 100
//    lw   x9,  0(x10)       # x9 = 100

//    add  x11, x9, x2       # dependency: x11 = 105
//    sw   x11, 4(x10)       # [0x104] = 105
//    lw   x12, 4(x10)       # x12 = 105
//    sb   x1,  8(x10)       # byte store 100
//    lb   x13, 8(x10)       # signed byte load
//    lbu  x14, 8(x10)       # unsigned byte load
//    sh   x1,  12(x10)      # halfword store 100
//    lh   x15, 12(x10)      # signed halfword load
//    lhu  x16, 12(x10)      # unsigned halfword load
//    beq  x13, x14, label1  # should be taken
//    addi x17, x0, 1        # should not execute
//label1:
//    bne  x15, x16, error   # should not be taken
//    add  x18, x15, x16     # x18 = 200
//    jal  x19, done         # jump to done
//    addi x20, x0, 9        # should not execute
//error:
//    addi x31, x0, -1       # error flag
//done:
//    beq  x0, x0, done      # infinite loop